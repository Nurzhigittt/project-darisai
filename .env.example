# DärisAI local development environment.
# Every value below is a development default. Replace all secrets before any deployment.
ENVIRONMENT=development
APP_BASE_URL=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:8000/ws
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local non-Docker defaults. Docker Compose overrides hosts with service names.
DATABASE_URL=postgresql://daris:daris@localhost:55432/daris
TEST_DATABASE_URL=postgresql://daris:daris@localhost:55432/daris_test
REDIS_URL=redis://localhost:6379/0

# Generate real values with: openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-change-before-deploy-3dbb2b32e29a4bd1
TOKEN_SIGNING_SECRET=dev-only-token-secret-change-before-deploy-3dbb2b32e29a4bd1
RATE_LIMIT_SECRET=dev-only-rate-limit-secret-change-before-deploy-72ee3c56
JWT_ISSUER=daris-ai
JWT_AUDIENCE=daris-ai-users
PROFESSOR_JWT_TTL_MINUTES=720
SIGNAL_TOKEN_TTL_MINUTES=240
REPLAY_TOKEN_TTL_MINUTES=1440

# Development-only seeding. AUTO_SEED must be false in production.
AUTO_SEED=true
SEED_PROFESSOR_INVITE_CODE=DARIS-TEACH-2026
SEED_PROFESSOR_NAME=Professor Demo
SEED_COURSE_TITLE=Applied Physics

RUN_MIGRATIONS=false
LOG_LEVEL=INFO
WS_HEARTBEAT_SECONDS=20
WS_HELLO_TIMEOUT_SECONDS=3
WS_MAX_MESSAGE_BYTES=4096
SIGNAL_COOLDOWN_MS=15000
RATE_LIMIT_JOIN_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10

# P3 Axiom / Temporal RAG.
# ONNX E5 is downloaded lazily into this ignored cache on first use. The
# production default is real embeddings; tests override it with `fake`.
AXIOM_EMBEDDING_PROVIDER=onnx_e5
AXIOM_EMBEDDING_MODEL=intfloat/multilingual-e5-small
AXIOM_EMBEDDING_ONNX_FILE=onnx/model_O4.onnx
AXIOM_EMBEDDING_CACHE_DIR=.model_cache
AXIOM_EMBEDDING_BATCH_SIZE=16
AXIOM_EMBEDDING_CONCURRENCY=2
AXIOM_RETRIEVAL_TOP_K=4
AXIOM_BEFORE_MS=90000
AXIOM_AFTER_MS=10000
AXIOM_SIMILARITY_FLOOR=0.78
AXIOM_MAX_CONTEXT_CHARS=12000

# Leave disabled for an offline/template demo. The adapter is
# OpenAI-compatible; set the endpoint and model explicitly and keep keys in
# your shell or secret manager, never in Git.
# disabled (template fallback) | ollama (local) | openai_compatible (cloud) | fake (tests)
AXIOM_LLM_PROVIDER=disabled
AXIOM_LLM_BASE_URL=https://api.deepseek.com
AXIOM_LLM_API_KEY=
AXIOM_LLM_MODEL=deepseek-flash
AXIOM_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
AXIOM_LOCAL_LLM_MODEL=qwen2.5:1.5b
AXIOM_LOCAL_LLM_MAX_TOKENS=800
AXIOM_LOCAL_LLM_KEEP_ALIVE=5m
AXIOM_LLM_TIMEOUT_SECONDS=20
AXIOM_LLM_MAX_RETRIES=1
AXIOM_LLM_MAX_OUTPUT_TOKENS=2400
AXIOM_LLM_CONCURRENCY=2
AXIOM_DAILY_GENERATION_BUDGET=100
AXIOM_REPLAY_MAX_TURNS=6
AXIOM_STATE_TTL_MINUTES=30
AXIOM_MOMENT_TTL_MINUTES=120

# Whisper-compatible speech-to-text. Disabled by default. The provider is
# configurable; no audio is retained by the application.
# disabled | faster_whisper (local CPU INT8) | openai_compatible (cloud)
AXIOM_STT_PROVIDER=disabled
AXIOM_STT_BASE_URL=https://api.openai.com/v1
AXIOM_STT_API_KEY=
AXIOM_STT_MODEL=whisper-1
AXIOM_LOCAL_STT_MODEL=small
AXIOM_LOCAL_STT_COMPUTE_TYPE=int8
AXIOM_LOCAL_STT_DOWNLOAD_ROOT=.model_cache/faster-whisper
AXIOM_STT_TIMEOUT_SECONDS=90
AXIOM_STT_MAX_FILE_BYTES=26214400

# Browser-visible configuration (Next.js build-time values).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/Nurzhigittt/project-darisai

AXIOM_EMBEDDING_PREWARM=false
AXIOM_REPLAY_REQUESTS_PER_TOKEN=40
AXIOM_STATE_SINGLE_USE=true
AXIOM_USE_LLM_JUDGES=false
AXIOM_LLM_DISABLE_THINKING=true
