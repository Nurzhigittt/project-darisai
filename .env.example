# DärisAI local development environment.
# Every value below is a development default. Replace all secrets before any deployment.
ENVIRONMENT=development
APP_BASE_URL=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:8000/ws
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local non-Docker defaults. Docker Compose overrides hosts with service names.
DATABASE_URL=postgresql://daris:daris@localhost:55432/daris
TEST_DATABASE_URL=postgresql://daris:daris@localhost:55432/daris_test
REDIS_URL=redis://localhost:6379/0

# Generate real values with: openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-change-before-deploy-3dbb2b32e29a4bd1
TOKEN_SIGNING_SECRET=dev-only-token-secret-change-before-deploy-3dbb2b32e29a4bd1
RATE_LIMIT_SECRET=dev-only-rate-limit-secret-change-before-deploy-72ee3c56
JWT_ISSUER=daris-ai
JWT_AUDIENCE=daris-ai-users
PROFESSOR_JWT_TTL_MINUTES=720
SIGNAL_TOKEN_TTL_MINUTES=240
REPLAY_TOKEN_TTL_MINUTES=1440

# Development-only seeding. AUTO_SEED must be false in production.
AUTO_SEED=true
SEED_PROFESSOR_INVITE_CODE=DARIS-TEACH-2026
SEED_PROFESSOR_NAME=Professor Demo
SEED_COURSE_TITLE=Applied Physics

RUN_MIGRATIONS=false
LOG_LEVEL=INFO
WS_HEARTBEAT_SECONDS=20
WS_HELLO_TIMEOUT_SECONDS=3
WS_MAX_MESSAGE_BYTES=4096
SIGNAL_COOLDOWN_MS=15000
RATE_LIMIT_JOIN_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10

# Browser-visible configuration (Next.js build-time values).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/hackathon-worldAI-2026-ULTRA/daris-ai
