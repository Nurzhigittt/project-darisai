  "components": {
    "schemas": {
      "ClusterOut": {
        "properties": {
          "cluster_id": {
            "type": "string",
            "format": "uuid",
            "title": "Cluster Id"
          },
          "start_ms": {
            "type": "integer",
            "title": "Start Ms"
          },
          "end_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Ms"
          },
          "peak_intensity": {
            "type": "number",
            "title": "Peak Intensity"
          },
          "unique_tokens": {
            "type": "integer",
            "title": "Unique Tokens"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cluster_id",
          "start_ms",
          "end_ms",
          "peak_intensity",
          "unique_tokens"
        ],
        "title": "ClusterOut"
      },
      "ColumnManifest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "nullable": {
            "type": "boolean",
            "title": "Nullable"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "type",
          "nullable"
        ],
        "title": "ColumnManifest"
      },
      "ComponentState": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "degraded"
            ],
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "title": "ComponentState"
      },
      "ControlRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "pause",
              "resume",
              "end"
            ],
            "title": "Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "ControlRequest"
      },
      "ControlResponse": {
        "properties": {
          "lecture_id": {
            "type": "string",
            "format": "uuid",
            "title": "Lecture Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "live",
              "paused",
              "ended"
            ],
            "title": "Status"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "offset_ms": {
            "type": "integer",
            "title": "Offset Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lecture_id",
          "status",
          "started_at",
          "ended_at",
          "offset_ms"
        ],
        "title": "ControlResponse"
      },
      "CourseCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 2,
            "title": "Title"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "CourseCreate"
      },
      "CourseOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at"
        ],
        "title": "CourseOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "unavailable"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "daris-ai-api"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "timestamp"
        ],
        "title": "HealthResponse"
      },
      "HeatmapBucket": {
        "properties": {
          "minute": {
            "type": "integer",
            "title": "Minute"
          },
          "minute_start_ms": {
            "type": "integer",
            "title": "Minute Start Ms"
          },
          "signals": {
            "type": "integer",
            "title": "Signals"
          },
          "unique": {
            "type": "integer",
            "title": "Unique"
          },
          "intensity": {
            "type": "number",
            "title": "Intensity"
          },
          "unique_semantics": {
            "type": "string",
            "title": "Unique Semantics",
            "default": "Distinct temporary participants observed in this minute; never the sum of per-bucket unique counts."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "minute",
          "minute_start_ms",
          "signals",
          "unique",
          "intensity"
        ],
        "title": "HeatmapBucket"
      },
      "HeatmapResponse": {
        "properties": {
          "lecture_id": {
            "type": "string",
            "format": "uuid",
            "title": "Lecture Id"
          },
          "bucket_ms": {
            "type": "integer",
            "const": 60000,
            "title": "Bucket Ms",
            "default": 60000
          },
          "buckets": {
            "items": {
              "$ref": "#/components/schemas/HeatmapBucket"
            },
            "type": "array",
            "title": "Buckets"
          },
          "clusters": {
            "items": {
              "$ref": "#/components/schemas/ClusterOut"
            },
            "type": "array",
            "title": "Clusters"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": "Signal counts are measured events. They are not a comprehension rate and low activity does not prove understanding."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lecture_id",
          "buckets",
          "clusters",
          "generated_at"
        ],
        "title": "HeatmapResponse"
      },
      "JoinPreview": {
        "properties": {
          "lecture": {
            "$ref": "#/components/schemas/PublicLecture"
          },
          "joinable": {
            "type": "boolean",
            "title": "Joinable"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lecture",
          "joinable",
